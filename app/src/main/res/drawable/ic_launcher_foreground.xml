    <!-- Screen inner subtle gradient (glass sheen) -->
    <path
        android:pathData="M36,38.75 h36 a5.25,5.25 0 0 1 5.25,5.25 v9.5 l-46.5,10.5 v-20 a5.25,5.25 0 0 1 5.25,-5.25 z">
