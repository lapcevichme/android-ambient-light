                android:startY="38"
                android:endX="54"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#28FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek Play Button Triangle -->
    <path
        android:pathData="M50,47.5 L62,54 L50,60.5 Z"
        android:fillColor="#FFFFFF" />
