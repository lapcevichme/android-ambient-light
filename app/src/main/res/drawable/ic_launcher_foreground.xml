    </path>

    <!-- Right ambient light ray beam -->
    <path android:pathData="M76,46 L76,62 L90,70 L90,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="76"
                android:startY="54"
                android:endX="90"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#99EA80FC" />
                <item android:offset="1.0" android:color="#00EA80FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Player Screen (rounded rectangle) -->
    <path
        android:pathData="M36,38 h36 a6,6 0 0 1 6,6 v20 a6,6 0 0 1 -6,6 h-36 a6,6 0 0 1 -6,-6 v-20 a6,6 0 0 1 6,-6 z"
