                android:type="linear">
                <item android:offset="0.0" android:color="#9980D8FF" />
                <item android:offset="1.0" android:color="#0080D8FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom ambient light ray beam -->
    <path android:pathData="M40,68 L68,68 L78,86 L30,86 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="68"
                android:endX="54"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#99FFAB40" />
                <item android:offset="1.0" android:color="#00FFAB40" />
